# StrataNodex CLI — Environment Variables
# Copy this file to .env ONLY if you need to override defaults.
# For normal use, you don't need a .env file at all.

# API Base URL (defaults to the hosted backend on Render)
# STRATANODEX_API_URL=http://localhost:3000

# Auth page URL (defaults to the hosted landing page on Vercel)
# STRATANODEX_AUTH_URL=http://localhost:3001

# Enable verbose logging
STRATANODEX_VERBOSE=false

# Guest mode — skip authentication for local testing (DO NOT use in production)
STRATANODEX_GUEST=false
